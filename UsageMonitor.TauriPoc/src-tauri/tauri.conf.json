{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenBurn",
  "version": "0.1.0",
  "identifier": "com.tokenburn.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TokenBurn",
        "width": 320,
        "height": 800,
        "minWidth": 320,
        "minHeight": 600,
        "maxWidth": 960,
        "maxHeight": 820,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:6736"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
