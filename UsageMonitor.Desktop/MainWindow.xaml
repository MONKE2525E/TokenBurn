<Window x:Class="UsageMonitor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UsageMonitor.Desktop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TokenBurn" Width="500" Height="680" MinWidth="440" MinHeight="520" MaxWidth="600" MaxHeight="820"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Closing="Window_OnClosing" PreviewKeyDown="Window_OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="20" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <local:ProgressWidthConverter x:Key="ProgressWidthConverter"/>
        <Style x:Key="SlimScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#64717B"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="1,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimScrollButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64717B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SlimScrollButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource SlimScrollThumb}"/></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SlimScrollButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="7"/><Setter Property="Width" Value="Auto"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--
            Chrome controls deliberately use vector geometry instead of font glyphs.  The
            macOS popover uses SF Symbols, while a Windows taskbar build cannot assume that
            Segoe UI contains the same symbol shapes (and a missing glyph collapses to a tiny
            square in the title bar).  Keeping these strokes in the visual tree also lets the
            existing QuietButton hover/pressed states tint the icon through the button's
            Foreground binding.
        -->
        <Style x:Key="ChromeGlyphPath" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="ChromeGlyphLine" TargetType="Line">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>
            <!-- WPF's default ToolTip is a bright, unbounded system popup.  Use the same
             charcoal surface as the popover, so keep hover/help affordances readable and compact
             instead of allowing a giant white rectangle to cover the dashboard. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="QuotaBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Background" Value="#3B3B3D"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="local:ProgressAnimationBehavior.Enabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExpanderHeaderToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource PanelRaisedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          Style="{StaticResource ExpanderHeaderToggle}"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            <ContentPresenter x:Name="ExpandSite"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Visibility="Collapsed"
                                              Opacity="0">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform Y="-4"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="HeaderSite" Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <EventTrigger SourceName="HeaderSite" RoutedEvent="ToggleButton.Checked">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ExpandSite" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="ExpandSite" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-4" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger SourceName="HeaderSite" Property="IsChecked" Value="False">
                                <Setter TargetName="ExpandSite" Property="Opacity" Value="0"/>
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderMetricCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" Padding="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Path Data="M 0,0 L 5,5 L 10,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>
                            <Popup x:Name="Popup" AllowsTransparency="True" Focusable="False" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="4" MinWidth="170">
                                    <ScrollViewer MaxHeight="220" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Toggle" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Toggle" Property="Background" Value="{StaticResource PanelRaisedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderMetricComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource PanelRaisedBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3B464C"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InlineMetricButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MetricButtonSurface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MetricButtonSurface" Property="Background" Value="{StaticResource PanelRaisedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MetricButtonSurface" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.72"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="MetricTemplate">
            <Grid Margin="0,8,0,0" SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" Grid.Row="0" Grid.Column="0" TextTrimming="CharacterEllipsis"/>
                <!-- The original keeps the label line quiet. The value lives under the meter, so
                     duplicating it at the far right made the compact card read like two competing
                     values instead of one row. Keep the element for chart/template compatibility,
                     but collapse it by default. -->
                <TextBlock x:Name="ValueText" Text="{Binding Value}" Visibility="Collapsed" FontSize="15" FontWeight="SemiBold" Grid.Row="0" Grid.Column="1" TextAlignment="Right" Margin="12,0,0,0"/>
                <local:SparklineCanvas x:Name="Sparkline" Grid.Row="0" Grid.Column="1" Width="150" Height="28" Points="{Binding ChartPoints}" Accent="{StaticResource AccentBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <ProgressBar x:Name="Meter" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource QuotaBar}" Maximum="1" Value="{Binding Progress}" Margin="0,9,0,0"/>
                <Button x:Name="MetricValueButton" Grid.Row="2" Grid.Column="0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalContentAlignment="Left" Style="{StaticResource InlineMetricButton}" Margin="-2,5,0,0" Click="MetricValueButton_OnClick" IsEnabled="{Binding IsMeter}" ToolTip="Toggle used and remaining" AutomationProperties.Name="Toggle used and remaining">
                    <TextBlock x:Name="MetricValueText" Text="{Binding Value}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                </Button>
                <Button x:Name="MetricDetailButton" Grid.Row="2" Grid.Column="1" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalContentAlignment="Right" Style="{StaticResource InlineMetricButton}" Margin="10,5,-2,0" Click="MetricDetailButton_OnClick" IsEnabled="{Binding IsMeter}" ToolTip="Toggle reset countdown and exact time" AutomationProperties.Name="Toggle reset time display">
                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMeter}" Value="False">
                    <Setter TargetName="Meter" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="MetricValueText" Property="TextWrapping" Value="Wrap"/>
                    <Setter TargetName="MetricValueText" Property="TextTrimming" Value="None"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChart}" Value="True">
                    <Setter TargetName="ValueText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="MetricValueButton" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="MetricDetailButton" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Sparkline" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="warn">
                    <Setter TargetName="Meter" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="danger">
                    <Setter TargetName="Meter" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ProviderTemplate">
            <StackPanel Margin="0,0,0,16">
                <Grid Margin="4,0,4,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="28" Height="28" Data="{Binding LogoGeometry}" Fill="{Binding Accent}" Stretch="Uniform" Margin="0,0,8,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Provider}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock Text="{Binding Plan}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Used}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Limit}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="15" Padding="15,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="ALWAYS VISIBLE" Style="{StaticResource GroupLabel}" FontSize="10"/>
                            <TextBlock Text="{Binding Reset}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding AlwaysMetrics}" ItemTemplate="{StaticResource MetricTemplate}"/>
                        <Expander x:Name="DemandExpander" Grid.Row="2" Style="{StaticResource MetricExpander}" IsExpanded="False" Margin="0,8,0,0">
                            <Expander.Header>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="ON DEMAND" Style="{StaticResource GroupLabel}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding OnDemandMetrics.Count, StringFormat={}{0} more}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0"/>
                                    <TextBlock Text="+" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,-3,0,0"/>
                                </DockPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding OnDemandMetrics}" ItemTemplate="{StaticResource MetricTemplate}" Margin="0,0,0,3"/>
                        </Expander>
                        <Button x:Name="ProviderActionButton" Grid.Row="3" Content="{Binding ActionLabel}" Click="ProviderAction_OnClick"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Padding="11,6"
                                AutomationProperties.Name="Provider recovery action">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAction}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding OnDemandMetrics.Count}" Value="0">
                    <Setter TargetName="DemandExpander" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Storyboard x:Key="EntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="DashboardSurface" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32"/>
            <DoubleAnimation Storyboard.TargetName="DashboardSlide" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="DashboardSurface" Opacity="0" Background="Transparent">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="DashboardSlide" Y="12"/>
        </Grid.RenderTransform>
        <Border x:Name="ShellSurface" Background="{StaticResource CanvasBrush}" BorderBrush="#47515A" BorderThickness="1" CornerRadius="20" Padding="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.52" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="16,10,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="ChromeBar" Grid.Row="0" Height="42" Margin="0,0,0,4" MouseLeftButtonDown="ChromeBar_OnMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="TopMetricPicker" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource HeaderMetricCombo}" ItemContainerStyle="{StaticResource HeaderMetricComboItem}" SelectionChanged="TopMetricPicker_OnSelectionChanged">
                        <ComboBoxItem Content="Cost"/>
                        <ComboBoxItem Content="Cost/MTok"/>
                        <ComboBoxItem Content="Tokens"/>
                    </ComboBox>
                    <Button x:Name="InfoButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="InfoButton_OnClick" Style="{StaticResource QuietButton}" Width="32" Height="32" Padding="0" Margin="7,0,0,0" ToolTip="Spend history includes only local provider history; estimates are labeled." AutomationProperties.Name="Spend history information">
                        <Grid Width="16" Height="16">
                            <Ellipse Width="15" Height="15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.5"/>
                            <TextBlock Text="i" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                        </Grid>
                    </Button>
                    <Border x:Name="SpendEstimateBadge" Visibility="Collapsed" Background="#3A301B" CornerRadius="6" Padding="6,3" Margin="6,0,0,0" ToolTip="Local spend is estimated from session history, not a bill.">
                        <TextBlock x:Name="SpendEstimateText" Text="ESTIMATED" FontSize="8" FontWeight="SemiBold" Foreground="#F4BE59"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ShareSpendButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="ShareScreenshotButton_OnClick" Style="{StaticResource QuietButton}" Width="36" Height="32" Padding="0" Margin="0,0,2,0" ToolTip="Copy spend screenshot" AutomationProperties.Name="Copy spend screenshot">
                        <!-- Match TotalSpendCard's share affordance with vector sheets so it stays
                             legible on Windows at both 100% and 200% DPI. -->
                        <Path Data="M 6,4 H 14 V 14 H 6 Z M 10,8 H 18 V 18 H 10 Z" Width="16" Height="16" Style="{StaticResource ChromeGlyphPath}" StrokeThickness="1.45"/>
                    </Button>
                    <Button x:Name="RefreshButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="RefreshButton_OnClick" Style="{StaticResource QuietButton}" Width="36" Height="32" Padding="0" Margin="0,0,2,0" ToolTip="Refresh all providers" AutomationProperties.Name="Refresh all providers">
                        <Path Data="M 14,4 A 6,6 0 1 0 15,10 M 14,4 L 14,1 M 14,4 L 11,4" Width="16" Height="16" Style="{StaticResource ChromeGlyphPath}"/>
                    </Button>
                    <Button x:Name="OptionsButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OptionsButton_OnClick" Style="{StaticResource QuietButton}" Width="76" Height="32" Padding="8,0" ToolTip="Open settings" AutomationProperties.Name="Settings">
                        <TextBlock Text="Settings" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MinimizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeButton_OnClick" Style="{StaticResource QuietButton}" Width="36" Height="32" Padding="0" Margin="3,0,0,0" ToolTip="Minimize to taskbar" AutomationProperties.Name="Minimize to taskbar">
                        <Line X1="4" Y1="8" X2="12" Y2="8" Style="{StaticResource ChromeGlyphLine}"/>
                    </Button>
                    <Button x:Name="CloseButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_OnClick" Style="{StaticResource QuietButton}" Width="36" Height="32" Padding="0" ToolTip="Hide to taskbar and tray" AutomationProperties.Name="Hide to taskbar and tray">
                        <Grid Width="16" Height="16">
                            <Line X1="4" Y1="4" X2="12" Y2="12" Style="{StaticResource ChromeGlyphLine}"/>
                            <Line X1="12" Y1="4" X2="4" Y2="12" Style="{StaticResource ChromeGlyphLine}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="LastUpdatedText" Grid.Row="0" Text="Waiting for a local provider" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,8"/>
                <local:SpendRingCard x:Name="SpendCard" Grid.Row="1"/>
            </Grid>

            <!-- Keep wheel and keyboard scrolling, but hide the permanent rail. The compact view only
                 reveals an indicator while scrolling, which leaves the compact popover clean. -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Provider limits" FontSize="15" FontWeight="SemiBold"/>
                            <Border Background="#203B3A" CornerRadius="8" Padding="7,3" Margin="9,0,0,0">
                                <TextBlock Text="LIVE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ConnectedTextBlock" Text="0 of 5" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text=" connected" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ProviderCards}" ItemTemplate="{StaticResource ProviderTemplate}"/>
                    <Border Background="#182229" BorderBrush="#2D4C50" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,2,0,16">
                        <DockPanel>
                            <Border Width="26" Height="26" CornerRadius="13" Background="#203B3A" Margin="0,0,10,0">
                                <TextBlock Text="i" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Connect a provider to see live limits" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="TokenBurn never invents zeroes. Add a provider in Settings and the cards fill in when a safe credential is found." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="SurfaceFooterText" Text="Native taskbar button + tray" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="PrivacyFooter" Text="Local cache / loopback API only" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="OptionsFooterButton" Click="OptionsButton_OnClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7" AutomationProperties.Name="Settings" ToolTip="Open settings">
                    <TextBlock Text="Settings" FontSize="12" FontWeight="SemiBold"/>
                </Button>
            </Grid>
            </Grid>
        </Border>
    </Grid>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource EntranceStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>
</Window>
